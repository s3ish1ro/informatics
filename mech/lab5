import matplotlib.pyplot as plt
import numpy as np
from scipy.spatial import Delaunay

nx = 13
ny = 10
a = 2
points = []
number = 0
for x in np.linspace(0, 4 * a, nx):
    for y in np.linspace(0, 3 * a, ny):
        if not (a < x < 3 * a) or (a <= y <= 2 * a and a <= x <= 3 * a):
            points.append([x, y])


for i in range(len(points)):
    plt.scatter(points[i][0], points[i][1], color="black")

points = np.array(points)
tri = Delaunay(points)
tr = tri.simplices
newtr = []
for i in range(len(tr)):
    x_centr = (points[tr[i][0]][0] + points[tr[i][1]][0] + points[tr[i][2]][0])/3
    y_centr = (points[tr[i][0]][1] + points[tr[i][1]][1] + points[tr[i][2]][1])/3
    if x_centr <= a or x_centr >= 3 * a or (a <= y_centr <= 2 * a and a <= x_centr <= 3 * a):
        newtr.append(tr[i])


plt.triplot(points[:, 0], points[:, 1], newtr)
plt.show()



